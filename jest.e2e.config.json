{
  "testEnvironment": "node",
  "testMatch": [
    "**/__tests__/e2e/**/*.test.js"
  ],
  "globalSetup": "<rootDir>/__tests__/e2e/globalSetup.js",
  "globalTeardown": "<rootDir>/__tests__/e2e/globalTeardown.js",
  "setupFilesAfterEnv": ["<rootDir>/__tests__/e2e/setup.js"],
  "transform": {
    "^.+\\.js$": "babel-jest"
  },
  "testTimeout": 30000,
  "forceExit": true
}

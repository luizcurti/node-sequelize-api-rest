{
  "info": {
    "name": "API Rest Sequelize",
    "_postman_id": "12345-67890",
    "description": "Collection for all routes of the REST API (Users, Students, Photos, Tokens). Requests are ordered so the collection can be run top-to-bottom (e.g. via Newman) with no manual setup: each request chains state through collection variables (userId, token, studentId, ...) and covers both the happy path and the corresponding sad paths (validation errors, missing auth, not found).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "userEmail", "value": "", "type": "string" },
    { "key": "userPassword", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "studentEmail", "value": "", "type": "string" },
    { "key": "studentId", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time is reasonable', () => {",
          "  pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});"
        ]
      }
    }
  ],

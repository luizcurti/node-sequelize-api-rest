{
  "testEnvironment": "node",
  "testMatch": [
    "**/__tests__/unit/**/*.js",
    "**/__tests__/setup.js"
  ],
  "setupFilesAfterEnv": ["<rootDir>/__tests__/setup.js"],
  "transform": {
    "^.+\\.js$": "babel-jest"
  },
  "collectCoverageFrom": [
    "src/**/*.js",
    "!src/database/migrations/**",
    "!src/database/seeds/**",
    "!src/config/appConfig.js",
    "!src/server.js",
    "!src/app.js",
    "!src/routes/**"
  ]
}